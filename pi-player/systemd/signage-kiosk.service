[Unit]
Description=SignageMadeEasy kiosk display (labwc + Chromium)
After=signage-player.service systemd-user-sessions.service getty@tty1.service plymouth-quit.service ydotoold.service
Wants=signage-player.service ydotoold.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=signage
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

# Cheap, zero-cost defensive layer stacked alongside labwc's own HideCursor action
# (see ~/.config/labwc/rc.xml) — if the F13 keybind that triggers HideCursor ever
# fails to fire (ydotool/ydotoold unavailable, a labwc version too old to support
# the action — see rc.xml's comment), this at least clamps whatever cursor labwc
# falls back to drawing down to zero size, instead of the fully-untreated default.
Environment=XCURSOR_SIZE=0

# Fifth attempt at the visible-cursor problem cage never solved: five independent,
# real-hardware-tested approaches on cage all failed (disabling input devices,
# forcing native Wayland, a transparent Xcursor theme confirmed reaching cage's
# process via /proc/<pid>/environ, XCURSOR_SIZE=0 alone, and a synthetic
# off-screen ydotool warp confirmed actually executing) — cage's own maintainers
# have said hiding its cursor outright isn't something they intend to support.
# labwc is a different wlroots-based compositor with a real, documented
# HideCursor action (see rc.xml) — genuinely hides the pointer, not a theme/size
# trick. NOT verified on real hardware yet; the version-compatibility risk is
# real too (HideCursor needs labwc >=0.8.4 — the exact version this Pi's
# Raspberry Pi OS Trixie/armhf repo ships hasn't been confirmed from this
# sandbox) — see ~/.config/labwc/rc.xml and ~/.config/labwc/autostart for how
# it's actually triggered.
#
# Unlike cage (which exits the moment its one child app exits), labwc is a
# general-purpose compositor that keeps running with no windows if Chromium
# crashes — so ~/.config/labwc/autostart kills labwc itself once Chromium exits,
# which brings this whole ExecStart process down and lets Restart=always below
# relaunch the entire labwc+Chromium session together, matching cage's original
# crash-recovery behavior.
ExecStart=/usr/bin/labwc

Restart=always
RestartSec=2

[Install]
# Raspberry Pi OS Lite has no desktop stack and boots to multi-user.target, never
# graphical.target — a unit only WantedBy=graphical.target would never be pulled in
# at boot on this image (confirmed on real hardware: it stayed inactive/dead with
# zero log entries until started manually).
WantedBy=multi-user.target
