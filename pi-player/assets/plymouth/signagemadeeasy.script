// SignageMadeEasy boot splash — deliberately simple: no external image assets, no
// array/Math functions, nothing beyond the most standard, widely-used Plymouth
// script API surface. This can't be rendered or tested outside a real Linux boot
// environment (no DRM/framebuffer exists in a sandbox), so it's written to minimize
// the chance of a syntax/API mismatch rather than to be clever.

Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(1, 1, 1);

logo.image = Image.Text("SignageMadeEasy", 0, 0, 0, 1, "Sans Bold 48");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10);

// Spinner: four quarter-shaded circle glyphs cycled in sequence in the bottom-right
// corner — reads as a rotating circle without needing an image-rotation transform or
// any bitmap assets, just swapping which pre-rendered text glyph is shown.
spinner.frame_0 = Image.Text("◐", 0.5, 0.5, 0.5, 1, "Sans 32");
spinner.frame_1 = Image.Text("◓", 0.5, 0.5, 0.5, 1, "Sans 32");
spinner.frame_2 = Image.Text("◑", 0.5, 0.5, 0.5, 1, "Sans 32");
spinner.frame_3 = Image.Text("◒", 0.5, 0.5, 0.5, 1, "Sans 32");
spinner.sprite = Sprite(spinner.frame_0);
spinner.sprite.SetX(Window.GetWidth() - 70);
spinner.sprite.SetY(Window.GetHeight() - 70);
spinner.sprite.SetZ(10);

spinner.tick = 0;
spinner.frame = 0;

fun refresh_callback() {
  spinner.tick++;
  if (spinner.tick >= 6) {
    spinner.tick = 0;
    spinner.frame++;
    if (spinner.frame > 3) {
      spinner.frame = 0;
    }
    if (spinner.frame == 0) {
      spinner.sprite.SetImage(spinner.frame_0);
    }
    if (spinner.frame == 1) {
      spinner.sprite.SetImage(spinner.frame_1);
    }
    if (spinner.frame == 2) {
      spinner.sprite.SetImage(spinner.frame_2);
    }
    if (spinner.frame == 3) {
      spinner.sprite.SetImage(spinner.frame_3);
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
