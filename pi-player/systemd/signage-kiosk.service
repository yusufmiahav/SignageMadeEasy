[Unit]
Description=SignageMadeEasy kiosk display (cage + Chromium)
# systemd-logind.service and dbus.service are the actual root cause of the
# "XDG_RUNTIME_DIR is not set" crash-loop seen on real hardware (confirmed via
# journalctl: cage.c:299 fails on the first 2-3 boot attempts, then "self-heals"
# a few seconds later purely because Restart=always keeps buying time for logind
# to finish starting). PAMName=login below relies on pam_systemd to inject
# XDG_RUNTIME_DIR into this unit's own PAM session — that only happens if
# pam_systemd can reach systemd-logind over D-Bus at the moment THIS session
# opens. Without an explicit ordering dependency, nothing stops this unit from
# starting before logind/dbus are up, so pam_systemd silently no-ops (PAM as a
# whole still reports success) and cage gets an environment with no
# XDG_RUNTIME_DIR at all. The ExecStartPre bus-socket wait below is a separate,
# narrower check (an existing socket file doesn't guarantee a *new* session's
# own env injection will succeed) and isn't a substitute for this ordering.
After=signage-player.service systemd-user-sessions.service getty@tty1.service plymouth-quit.service ydotoold.service systemd-logind.service dbus.service
Wants=signage-player.service ydotoold.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=signage
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

# Final, confirmed-on-real-hardware conclusion after several attempts: cage
# cannot be made to render a genuinely invisible cursor. Neither this
# transparent Xcursor theme (XCURSOR_SIZE must be a real size like 24, not 0,
# or cage falls back to its normal default cursor instead of loading "blank"
# at all) nor CSS cursor:none on the page changes what cage itself draws —
# cage's cursor isn't something a client can hide, and cage's own maintainers
# have said outright that hiding it isn't something they support. Kept
# regardless since it's free and can only help, but see the ExecStartPost
# warp below for the part that actually does something: relocating the
# (still-visible) cursor to a corner, off the main content. See the root
# README's troubleshooting section for the full story before "fixing" this
# again — it's an accepted cosmetic limitation, not an open bug.
Environment=XCURSOR_THEME=blank
Environment=XCURSOR_SIZE=24
Environment=XCURSOR_PATH=/home/signage/.icons

# Second real bug, confirmed via journalctl on real hardware: cage's own
# startup check (cage.c:299) failed with "XDG_RUNTIME_DIR is not set in the
# environment" on the first 2-3 boot attempts (it kept self-healing within
# ~30-60s via Restart=always below, but that's still a failed/blank kiosk for a
# while on every boot). Root-caused to the missing systemd-logind.service/
# dbus.service ordering in [Unit] above, which is the real fix — see that
# comment. Everything below this point predates that fix and is kept as
# defense-in-depth, not the primary mechanism anymore.
#
# A previous fix here pointed XDG_RUNTIME_DIR at a directory systemd's own
# RuntimeDirectory= created, to sidestep the race entirely — that was wrong
# and confirmed broken on real hardware: libseat needs the *actual*
# pam_systemd-managed /run/user/<uid> (it hosts the D-Bus session bus socket
# logind is reached through), not just some XDG_RUNTIME_DIR-shaped directory.
# Pointing it elsewhere made libseat unable to reach logind at all
# ("Could not connect to logind"), which cascaded into libinput failing to
# init and cage never starting its wlroots backend — worse than the original
# race, since it no longer self-healed via Restart=always.
#
# Waits for the real thing instead of substituting a fake one: poll for
# pam_systemd's own /run/user/<uid>/bus (the file that specifically indicates
# the D-Bus session libseat needs is actually up), up to 10s, then proceed
# regardless — if it's still not there, cage will fail exactly as before and
# Restart=always below still recovers, same self-healing safety net as ever.
#
# Deliberately NOT %U: confirmed on real hardware that %U resolves to 0 (the
# service manager's own UID, i.e. root — PID 1 always runs as root) for a
# system-level unit, not this unit's own User=signage — that specifier only
# means "the user this unit runs as" inside a per-user (systemd --user)
# instance. Looks up signage's real UID directly instead.
ExecStartPre=/bin/sh -c 'u=$(id -u signage); for i in $(seq 1 40); do [ -S "/run/user/$u/bus" ] && exit 0; sleep 0.25; done; exit 0'

# --kiosk: fullscreen, no chrome. --noerrdialogs/--disable-session-crashed-bubble:
# no "restore pages?" prompts after a power-cut reboot. --check-for-update-interval
# set absurdly high since there's no reason a kiosk display should ever prompt to
# update itself. --ozone-platform=wayland forces Chromium to run as a genuine
# Wayland client of cage instead of possibly falling back to cage's built-in
# XWayland compatibility layer — confirmed via real hardware ps/journalctl output
# to be honored. Doesn't affect the cursor.
#
# --remote-debugging-port/--remote-debugging-address: opens real DevTools at
# http://<pi-ip>:9222 from any device on the LAN — used to diagnose real
# on-device video playback issues that never reproduced in a sandbox. Same
# LAN-trust model as everything else here (no auth anywhere in this project);
# bound to 0.0.0.0 on purpose. Chromium itself still only binds the DevTools
# socket to 127.0.0.1 regardless of this flag (a hardening behavior, confirmed
# on real hardware) — reach it via `ssh -L 9222:localhost:9222 pi@<ip>` +
# chrome://inspect, not this flag alone.
#
# --disable-accelerated-video-decode: diagnosed via that remote DevTools console
# on real hardware — a long (2min+) video reliably stalled with networkState
# idle and readyState stuck at "have current data", at the exact same point
# every time, with the cached file confirmed byte-identical to the original
# (ruling out a truncated download) and zero new kernel dmesg entries at the
# moment of the freeze (ruling out an OOM kill or a kernel-level GPU driver
# reset). That combination points at Chromium's own hardware video decode
# pipeline (VideoCore GPU via V4L2) silently hanging partway through — a known
# rough edge on this platform, not something fixable from the page's
# JavaScript. Forcing software decode trades CPU load (confirmed choppier on
# real hardware — re-encode source video to 720p H.264 if that's a problem,
# see the troubleshooting section in the root README) for Chromium's far more
# mature, battle-tested decode path.
#
# Moot but harmless as of pi-player/src/mpvPlayer.ts: video no longer plays through
# Chromium's <video> element at all (mpv handles it as a separate hardware-decoded
# process instead — see pi-player/README.md), so this flag has nothing left to act
# on. Left in place rather than removed since Chromium still needs to not fight mpv
# for the GPU decode unit if anything ever routes video through it again.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --kiosk http://localhost:8088 \
  --ozone-platform=wayland \
  --disable-accelerated-video-decode \
  --remote-debugging-port=9222 \
  --remote-debugging-address=0.0.0.0 \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --no-first-run \
  --check-for-update-interval=31536000 \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required

# Confirmed on real hardware: this relocates the cursor to the bottom-right
# corner, off the main content — but the cursor itself stays visible there;
# see the XCURSOR_* comment above and the root README for why full invisibility
# on cage isn't achievable, and why the corner cursor is an accepted, final
# state rather than a bug to keep chasing. Uses a synthetic input device
# (ydotoold/ydotool — see provision.sh) indistinguishable from a real mouse at
# the kernel level, so the relocation works regardless of what cage's own
# cursor-rendering does or doesn't honor.
#
# Retries every second for 15s instead of firing once after a fixed sleep:
# confirmed on real hardware that a single "sleep 3, then warp" attempt can
# silently no-op on a slow boot — ydotool reports success either way (writing
# to the synthetic input device succeeds regardless of whether cage's own
# input backend has finished initializing enough to actually consume the
# event yet), so a single attempt gives no signal that it didn't land. Same
# race as the ExecStartPre wait above, just on cage's seat/input backend
# instead of pam_systemd's runtime dir — a boot slow enough to need several
# kiosk restarts before succeeding (see that comment) leaves cage starting
# later than a fixed 3s assumes. Repeating is harmless: warping an
# already-warped cursor to the same corner again is a no-op.
# `|| true` at the very end: this must never be able to fail the unit. A
# failed ExecStartPost marks Type=simple services as failed too, and with
# Restart=always that would crash-loop the whole kiosk — killing a working
# cage/Chromium — over nothing worse than ydotool being unavailable
# (provision.sh installs it best-effort; not every release has it in its
# default repo).
ExecStartPost=/bin/sh -c 'for i in $(seq 1 15); do sleep 1; YDOTOOL_SOCKET=/tmp/.ydotool_socket /usr/bin/ydotool mousemove -- 10000 10000 2>/dev/null; done || true'

Restart=always
RestartSec=2

[Install]
# Raspberry Pi OS Lite has no desktop stack and boots to multi-user.target, never
# graphical.target — a unit only WantedBy=graphical.target would never be pulled in
# at boot on this image (confirmed on real hardware: it stayed inactive/dead with
# zero log entries until started manually).
WantedBy=multi-user.target
