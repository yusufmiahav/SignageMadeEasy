[Unit]
Description=SignageMadeEasy player agent (local API + hub poller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signage
WorkingDirectory=/opt/signage/app
Environment=PORT=8088
Environment=SIGNAGE_CONFIG_PATH=/opt/signage/config.json
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=2
# Brings this process straight back up after a genuine crash/OOM kill — NOT how
# the control app's "Restart" button takes effect any more; that's a real
# `sudo reboot` now (see agent.ts's /restart handler), which naturally restarts
# this service too as one part of the whole machine coming back up.

[Install]
WantedBy=multi-user.target
