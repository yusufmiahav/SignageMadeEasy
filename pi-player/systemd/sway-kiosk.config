# Minimal sway config for a single-app kiosk display — see pi-player/README.md's
# "Cursor" section for why this replaced cage. Used standalone via `sway -c
# <this file>` (see signage-kiosk.service), not merged with /etc/sway/config's
# own defaults, so nothing here relies on anything sway ships out of the box.
#
# CHROMIUM_BIN and the --disable-accelerated-video-decode line below are
# templated by provision.sh (sed) the same way they used to be on the old
# cage-based signage-kiosk.service — see that script's "Installing systemd
# units" step.

# No XWayland needed — chromium is launched with --ozone-platform=wayland
# below, so it's always a native Wayland client.
xwayland disable

output * bg #000000 solid_color

default_border none
for_window [app_id=".*"] fullscreen enable

# The actual fix for the cursor problem cage could never solve: sway's own
# built-in, documented hide_cursor command (unlike cage, which has no cursor
# API at all — see pi-player/README.md). 100 is sway's own minimum timeout in
# ms; a kiosk has no real mouse activity, so this hides the cursor almost
# immediately after startup and it simply stays hidden.
seat seat0 hide_cursor 100

exec /usr/bin/chromium \
  --kiosk http://localhost:8088 \
  --ozone-platform=wayland \
  --disable-accelerated-video-decode \
  --remote-debugging-port=9222 \
  --remote-debugging-address=0.0.0.0 \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-translate \
  --no-first-run \
  --check-for-update-interval=31536000 \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required
